+class OrchestrationTest(unittest.TestCase):
+    def run_feedback(self, *, scenario='two_queries', initial_target=0, transform=None):
+        original_create = hf.FeedbackQueue.create
+        saved = {}
+        def create(trace, run, decisions):
+            q = original_create(trace, run, decisions)
+            enqueue(q, 'initial', initial_target, 'INITIAL_COACHING')
+            saved['queue'] = q
+            return q
+        def response(value, index, schema):
+            if transform: return transform(saved['queue'], value, index, schema)
+            return value
+        with mock.patch.object(hf.FeedbackQueue, 'create', side_effect=create):
+            return query_fixture.QueryTests().run_client(scenario=scenario,
+                extra_flags=('--mode','dressing','--allow-human-feedback'), response_transform=response)
+
+    def test_new_feedback_during_query_waits_until_next_decision(self):
+        def transform(queue, value, index, schema):
+            if index == 0:
+                enqueue(queue, 'next', 1, 'NEXT_DECISION_ONLY')
+                with self.assertRaisesRegex(ValueError, 'stale'): enqueue(queue, 'stale', 0)
+            return value
+        r = self.run_feedback(transform=transform)
+        self.assertIsNone(r['error'])
+        calls = r['calls']
+        self.assertIn('INITIAL_COACHING', calls[0]['prompt'])
+        self.assertTrue(calls[1]['prompt'].startswith(calls[0]['prompt']))
+        self.assertNotIn('NEXT_DECISION_ONLY', calls[0]['prompt']+calls[1]['prompt'])
+        self.assertIn('NEXT_DECISION_ONLY', calls[2]['prompt'])
+        self.assertTrue(calls[3]['prompt'].startswith(calls[2]['prompt']))
+        self.assertEqual(calls[0]['images'], calls[1]['images'])
+        self.assertEqual(r['order'], ['call0','call1','act','call2','call3','finish_episode'])
+        self.assertEqual(r['attempt']['human_feedback']['delivered_messages'], 2)
+        self.assertTrue(r['attempt']['human_intervention'])
+        self.assertEqual(r['attempt']['source'], 'human_corrected_gpt')
+        self.assertNotIn('NEVER_ACTOR', str(calls))
+
+    def test_timeout_uncertain_and_accepted_but_undelivered_do_not_conflate(self):
+        r = self.run_feedback(scenario='timeout_first')
+        self.assertIsInstance(r['error'], TimeoutError)
+        self.assertTrue(r['attempt']['human_intervention'])
+        self.assertEqual(r['attempt']['human_feedback']['uncertain_messages'], 1)
+        # Two-decision budget, but actor ends at the first boundary.
+        def finish_first(queue, value, index, schema):
+            value = query_fixture.action()
+            if 'depth_query' in schema['properties']: value['depth_query'] = None
+            return value
+        r = self.run_feedback(initial_target=1, transform=finish_first)
+        self.assertIsNone(r['error'])
+        self.assertFalse(r['attempt']['human_intervention'])
+        self.assertEqual(r['attempt']['source'], 'gpt')
+        self.assertEqual(r['attempt']['human_feedback']['messages'][0]['status'], 'not_delivered_closed')
+
+    def test_enqueue_during_physics_dispatch_waits_for_new_observation_boundary(self):
+        original_create=hf.FeedbackQueue.create
+        saved={}
+        def create(trace,run,decisions):
+            saved['queue']=original_create(trace,run,decisions)
+            return saved['queue']
+        def during_dispatch(tool,args):
+            if tool=='act':
+                receipt=enqueue(saved['queue'],'during-action',1,'AFTER_ACTION_BOUNDARY_ONLY')
+                self.assertFalse(receipt['delivered'])
+                self.assertFalse(saved['queue'].status()['human_intervention'])
+        with mock.patch.object(hf.FeedbackQueue,'create',side_effect=create):
+            r=query_fixture.QueryTests().run_client(scenario='two_queries',
+                extra_flags=('--mode','dressing','--allow-human-feedback'),dispatch_hook=during_dispatch)
+        self.assertIsNone(r['error'])
+        self.assertNotIn('AFTER_ACTION_BOUNDARY_ONLY',r['calls'][0]['prompt']+r['calls'][1]['prompt'])
+        self.assertIn('AFTER_ACTION_BOUNDARY_ONLY',r['calls'][2]['prompt'])
+        self.assertEqual(r['attempt']['human_feedback']['first_direct_affected_transition_boundary'],2)
+
+    def test_disabled_matches_pinned_pre_feature_actor_inputs_and_requests(self):
+        baseline = ModuleType('feedback_off_baseline')
+        baseline.__file__ = str(ROOT/'participant/collection/codex_client.py')
+        source = subprocess.check_output(['git','show',BASE_COMMIT+':participant/collection/codex_client.py'],cwd=ROOT,text=True)
+        exec(compile(source,baseline.__file__,'exec'),baseline.__dict__)
+        with mock.patch.object(hf.FeedbackQueue,'create',side_effect=AssertionError('must stay disabled')):
+            old = query_fixture.QueryTests().run_client(module=baseline, scenario='two_queries')
