+def enqueue(queue, name, target, text='Keep useful support and reassess the current view.'):
+    return queue.enqueue(name, target, text, public_observations_only=True, user_authorized=True)
+
+
+class QueueTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = Path(self.tmp.name)
+        self.queue = hf.FeedbackQueue.create(self.path, 'future-run', 3)
+
+    def test_order_acceptance_delivery_and_once_only(self):
+        a = enqueue(self.queue, 'a', 0, 'FIRST')
+        b = enqueue(self.queue, 'b', 0, 'SECOND')
+        self.assertEqual([a['status'], b['status']], ['accepted', 'accepted'])
+        self.assertFalse(a['delivered'])
+        self.assertFalse(self.queue.status()['human_intervention'])
+        prompt = self.queue.begin_decision(0, 738)
+        self.assertLess(prompt.index('FIRST'), prompt.index('SECOND'))
+        self.assertFalse(self.queue.status()['human_intervention'])
+        self.assertTrue(self.queue.dispatch(0, 0, 'a'*64))
+        self.assertTrue(self.queue.status()['human_intervention'])
+        self.assertEqual(self.queue.status()['assistance_status'], 'delivery_uncertain')
+        self.queue.acknowledge(0, delivered=True)
+        self.assertFalse(self.queue.dispatch(0, 1, 'b'*64))
+        self.assertEqual(self.queue.status()['delivered_messages'], 2)
+        self.assertEqual(self.queue.status()['first_affected_transition_boundary'], 738)
+        self.assertNotIn('FIRST', json.dumps(self.queue.status()))
+
+    def test_inflight_future_enqueue_stale_mismatch_duplicate_and_bounds(self):
+        self.queue.begin_decision(0, 0)
+        with self.assertRaisesRegex(ValueError, 'stale'):
+            enqueue(self.queue, 'late', 0)
+        enqueue(self.queue, 'next', 1)
+        with self.assertRaisesRegex(ValueError, 'duplicate'):
+            enqueue(self.queue, 'next', 2)
+        with self.assertRaisesRegex(ValueError, 'run mismatch'):
+            enqueue(hf.FeedbackQueue(self.queue.path, 'different-run'), 'wrong', 1)
+        for target in (True, -1, 3):
+            with self.assertRaises(ValueError): enqueue(self.queue, 'bad', target)
+        with self.assertRaisesRegex(ValueError, 'exactly once'):
+            self.queue.begin_decision(0, 0)
+        self.assertIn('next', self.queue.begin_decision(1, 20))
+
+    def test_validation_closed_queue_and_disabled_path_never_creates(self):
+        for text in ('', 'a'*2001, 'bad\x00text', '\u202eevil'):
+            with self.assertRaises(ValueError): enqueue(self.queue, 'bad', 0, text)
+        with self.assertRaisesRegex(ValueError, 'authorization'):
+            self.queue.enqueue('no-attestation', 0, 'Valid text')
+        for i in range(4): enqueue(self.queue, f'item{i}', 0)
+        with self.assertRaisesRegex(ValueError, 'capacity'):
+            enqueue(self.queue, 'fifth', 0)
+        self.queue.close()
+        self.assertFalse(self.queue.status()['human_intervention'])
+        self.assertTrue(all(m['status']=='not_delivered_closed' for m in self.queue.status()['messages']))
+        with self.assertRaisesRegex(ValueError, 'closed'): enqueue(self.queue, 'closed', 1)
+        missing = self.path/'disabled'/hf.FILENAME
+        with self.assertRaisesRegex(ValueError, 'not enabled'):
+            enqueue(hf.FeedbackQueue(missing, 'disabled'), 'no', 0)
+        self.assertFalse(missing.parent.exists())
+        self.assertEqual(self.queue.path.stat().st_mode & 0o777, 0o600)
+
+    def test_concurrent_enqueues_are_serialized_without_lost_messages(self):
+        from concurrent.futures import ThreadPoolExecutor
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            results = list(pool.map(lambda i: enqueue(self.queue, f'msg{i}', 1), range(4)))
+        self.assertEqual(sorted(r['sequence'] for r in results), list(range(4)))
+        ledger = hf.read_ledger(self.queue.path, 'future-run')
+        self.assertEqual(len({m['message_id'] for m in ledger['messages']}), 4)
+        self.assertEqual([m['sequence'] for m in ledger['messages']], list(range(4)))
+
+    def test_failed_dispatch_is_uncertain_never_requeued_and_capture_is_marked(self):
+        enqueue(self.queue, 'one', 0, 'PRIVATE_COACHING_CANARY')
+        self.queue.begin_decision(0, 8)
+        self.queue.dispatch(0, 0, 'a'*64)
+        self.queue.acknowledge(0, delivered=False)
+        self.queue.close()
+        self.assertEqual(self.queue.status()['uncertain_messages'], 1)
+        with h5py.File(self.path/'policy.hdf5','w') as policy, h5py.File(self.path/'audit.hdf5','w') as audit:
+            policy.create_dataset('actions', data=[1,2,3])
+            metadata = hf.capture_provenance(SimpleNamespace(policy=policy,audit=audit), self.queue.path, 'future-run')
+            self.assertTrue(policy.attrs['human_intervention'])
+            self.assertEqual(metadata['first_affected_transition_boundary'], 8)
+            self.assertEqual(policy['actions'][:].tolist(), [1,2,3])
+            self.assertNotIn('PRIVATE_COACHING_CANARY', policy.attrs['human_feedback_provenance_json'])
+
+    def test_capture_seals_queue_and_final_metadata_hash_is_identical(self):
+        enqueue(self.queue, 'accepted-only', 2)
+        with h5py.File(self.path/'policy.hdf5','w') as policy, h5py.File(self.path/'audit.hdf5','w') as audit:
+            policy.create_group('data').create_group('demo_0')
+            audit.create_group('demo_0')
+            metadata = hf.capture_provenance(SimpleNamespace(policy=policy,audit=audit), self.queue.path, 'future-run')
+            with self.assertRaisesRegex(ValueError, 'closed'): enqueue(self.queue,'late',2)
+            before = self.queue.path.read_bytes()
+            self.queue.close()
+            self.assertEqual(before, self.queue.path.read_bytes())
+            self.assertEqual(metadata, hf.with_inherited(self.queue.status()))
+            self.assertEqual(metadata['ledger_sha256'], hashlib.sha256(before).hexdigest())
+            self.assertEqual(json.loads(policy['data/demo_0'].attrs['human_feedback_provenance_json']),metadata)
+            self.assertEqual(json.loads(audit['demo_0'].attrs['human_feedback_provenance_json']),metadata)
+
+    def test_seal_between_prepare_and_dispatch_rejects_frozen_guidance(self):
+        enqueue(self.queue,'one',0)
+        self.queue.begin_decision(0,10)
+        self.queue.close()
+        with self.assertRaisesRegex(ValueError,'closed before dispatch'):
+            self.queue.dispatch(0,0,'a'*64)
+        self.assertFalse(self.queue.status()['human_intervention'])
+
+    def test_inherited_and_direct_boundaries_are_separate(self):
+        enqueue(self.queue,'one',0)
+        self.queue.begin_decision(0,738);self.queue.dispatch(0,0,'a'*64)
+        combined=hf.with_inherited(self.queue.status(),{'parent_attempt':'parent','scope':'any_assisted_parent_prefix'})
+        self.assertEqual(combined['first_affected_transition_boundary'],0)
+        self.assertEqual(combined['first_direct_affected_transition_boundary'],738)
