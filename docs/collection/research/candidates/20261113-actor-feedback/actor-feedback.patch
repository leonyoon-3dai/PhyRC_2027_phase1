diff --git a/participant/collection/human_feedback.py b/participant/collection/human_feedback.py
new file mode 100644
index 0000000000000000000000000000000000000000..8166e61a8e3fad8d106d94f9929f21388bf62534
--- /dev/null
+++ b/participant/collection/human_feedback.py
@@ -0,0 +1,286 @@
+"""Opt-in, run-bound human text queue. Host only; never an actor tool.
+
+The queue is private provenance, not a semantic rules validator. Enqueue only
+explicitly authorized guidance derived from designated public observations.
+"""
+import argparse
+from contextlib import contextmanager
+from datetime import datetime, timezone
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import tempfile
+import unicodedata
+
+SCHEMA = 'phyrc-human-feedback-v1'
+FILENAME = 'human_feedback.json'
+MAX_TEXT_BYTES, MAX_MESSAGES, MAX_PER_DECISION = 2000, 64, 4
+MAX_FILE_BYTES = 512 * 1024
+STATES = {'accepted', 'prepared', 'dispatching', 'delivered', 'delivery_uncertain', 'not_delivered_closed'}
+DISPATCHED = {'dispatching', 'delivered', 'delivery_uncertain'}
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def identifier(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,119}', value):
+        raise ValueError('unsafe run/message ID')
+    return value
+
+
+def validate_text(value):
+    if (not isinstance(value, str) or not value.strip() or len(value.encode()) > MAX_TEXT_BYTES
+            or any(unicodedata.category(c).startswith('C') and c not in '\n\t' for c in value)):
+        raise ValueError('feedback must be nonempty plain UTF-8 text, at most 2000 bytes')
+    return value
+
+
+def digest_text(value):
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def _safe_path(path):
+    path = Path(path).absolute()
+    if '..' in path.parts or any(p.is_symlink() for p in (path, *path.parents)):
+        raise ValueError('feedback paths must not contain traversal or symlinks')
+    return path
+
+
+def read_ledger(path, run_id):
+    path = _safe_path(path)
+    if not path.is_file() or path.stat().st_size > MAX_FILE_BYTES:
+        raise ValueError('feedback not enabled or invalid queue file')
+    value = json.loads(path.read_text())
+    if value.get('schema') != SCHEMA or value.get('run_id') != identifier(run_id):
+        raise ValueError('feedback run mismatch or invalid schema')
+    if value.get('enabled') is not True or value.get('state') not in ('open', 'closed'):
+        raise ValueError('invalid feedback queue state')
+    if type(value.get('decisions')) is not int or not 1 <= value['decisions'] <= 2000:
+        raise ValueError('invalid feedback decision budget')
+    if type(value.get('next_decision_index')) is not int or not 0 <= value['next_decision_index'] <= value['decisions']:
+        raise ValueError('invalid feedback boundary')
+    messages = value.get('messages')
+    if not isinstance(messages, list) or len(messages) > MAX_MESSAGES:
+        raise ValueError('invalid feedback messages')
+    seen, per_decision = set(), {}
+    for sequence, message in enumerate(messages):
+        identifier(message['message_id'])
+        target = message['target_decision_index']
+        if (message['message_id'] in seen or message['sequence'] != sequence
+                or type(target) is not int or not 0 <= target < value['decisions']
+                or message['status'] not in STATES or message['public_observations_only'] is not True
+                or message['user_authorized'] is not True
+                or digest_text(validate_text(message['text'])) != message['text_sha256']):
+            raise ValueError('invalid feedback message provenance')
+        seen.add(message['message_id'])
+        per_decision[target] = per_decision.get(target, 0) + 1
+    if any(count > MAX_PER_DECISION for count in per_decision.values()):
+        raise ValueError('too many messages at one boundary')
+    return value
+
+
+def summary(value):
+    """Metadata only. Raw text is kept exclusively in the private ledger."""
+    dispatched = [m for m in value['messages'] if m['status'] in DISPATCHED]
+    fields = ('message_id', 'sequence', 'text_sha256', 'target_decision_index', 'accepted_at_utc',
+              'status', 'delivery_decision_index', 'observation_step', 'prepared_at_utc',
+              'model_call_index', 'input_sha256', 'dispatch_at_utc', 'acknowledged_at_utc')
+    return {'enabled': True, 'accepted_messages': len(value['messages']),
+            'dispatched_messages': len(dispatched),
+            'delivered_messages': sum(m['status'] == 'delivered' for m in dispatched),
+            'uncertain_messages': sum(m['status'] in ('dispatching', 'delivery_uncertain') for m in dispatched),
+            'human_intervention': bool(dispatched),
+            'assistance_status': ('delivery_uncertain' if any(m['status'] != 'delivered' for m in dispatched)
+                                  else 'human_assisted' if dispatched else 'none_delivered'),
+            'first_affected_transition_boundary': min((m['observation_step'] for m in dispatched), default=None),
+            'private_provenance_file': FILENAME,
+            'messages': [{k: m[k] for k in fields if k in m} for m in value['messages']]}
+
+
+def with_inherited(metadata, inherited=None):
+    result = dict(metadata or {'enabled': False, 'accepted_messages': 0, 'dispatched_messages': 0,
+                              'delivered_messages': 0, 'uncertain_messages': 0, 'messages': [],
+                              'human_intervention': False, 'assistance_status': 'none_delivered'})
+    result['direct_human_intervention'] = result['human_intervention']
+    result['inherited_human_intervention'] = bool(inherited)
+    result['first_direct_affected_transition_boundary'] = result.get('first_affected_transition_boundary')
+    if inherited:
+        result['inherited_assistance'] = dict(inherited)
+        result['human_intervention'] = True
+        result['first_affected_transition_boundary'] = 0
+        if not result['direct_human_intervention']:
+            result['assistance_status'] = 'inherited_only'
+    return result
+
+
+class FeedbackQueue:
+    def __init__(self, path, run_id):
+        self.path, self.run_id = _safe_path(path), identifier(run_id)
+
+    @classmethod
+    def create(cls, trace, run_id, decisions):
+        queue = cls(Path(trace) / FILENAME, run_id)
+        value = {'schema': SCHEMA, 'run_id': run_id, 'enabled': True, 'state': 'open',
+                 'decisions': decisions, 'next_decision_index': 0, 'created_at_utc': now(), 'messages': []}
+        fd = os.open(queue.path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(value, stream, ensure_ascii=False); stream.flush(); os.fsync(stream.fileno())
+        read_ledger(queue.path, run_id)
+        return queue
+
+    @contextmanager
+    def transaction(self):
+        # An enqueue attempt cannot create a disabled run's queue or directories.
+        if not self.path.is_file():
+            raise ValueError('human feedback is not enabled for this run')
+        _safe_path(self.path)
+        lock = self.path.with_suffix('.lock')
+        fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, 'w') as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            value = read_ledger(self.path, self.run_id)
+            yield value
+            temporary_fd, temporary = tempfile.mkstemp(prefix='.feedback-', dir=self.path.parent)
+            try:
+                with os.fdopen(temporary_fd, 'w') as stream:
+                    json.dump(value, stream, ensure_ascii=False, indent=2)
+                    stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
+                os.replace(temporary, self.path)
+                directory = os.open(self.path.parent, os.O_DIRECTORY)
+                try: os.fsync(directory)
+                finally: os.close(directory)
+            finally:
+                if os.path.exists(temporary): os.unlink(temporary)
+
+    def enqueue(self, message_id, target, text, *, public_observations_only=False, user_authorized=False):
+        identifier(message_id); validate_text(text)
+        if public_observations_only is not True or user_authorized is not True:
+            raise ValueError('explicit user authorization and public-observation attestation required')
+        with self.transaction() as value:
+            if value['state'] != 'open': raise ValueError('feedback queue is closed')
+            if type(target) is not int or not value['next_decision_index'] <= target < value['decisions']:
+                raise ValueError('stale, inflight, or out-of-budget target decision')
+            if any(m['message_id'] == message_id for m in value['messages']):
+                raise ValueError('duplicate feedback message ID')
+            if len(value['messages']) >= MAX_MESSAGES or sum(
+                    m['target_decision_index'] == target for m in value['messages']) >= MAX_PER_DECISION:
+                raise ValueError('feedback queue capacity reached')
+            message = {'message_id': message_id, 'sequence': len(value['messages']),
+                       'target_decision_index': target, 'text': text, 'text_sha256': digest_text(text),
+                       'public_observations_only': True, 'user_authorized': True,
+                       'accepted_at_utc': now(), 'status': 'accepted'}
+            value['messages'].append(message)
+            receipt = {k: message[k] for k in ('message_id', 'sequence', 'target_decision_index',
+                                             'text_sha256', 'accepted_at_utc', 'status')}
+        return dict(receipt, run_id=self.run_id, delivered=False)
+
+    def begin_decision(self, index, observation_step):
+        with self.transaction() as value:
+            if value['state'] != 'open' or index != value['next_decision_index']:
+                raise ValueError('feedback boundary must be visited exactly once in order')
+            value['next_decision_index'] = index + 1
+            selected = [m for m in value['messages'] if m['target_decision_index'] == index and m['status'] == 'accepted']
+            for message in selected:
+                message.update(status='prepared', delivery_decision_index=index,
+                               observation_step=observation_step, prepared_at_utc=now())
+            # Freeze a copy before any model call; enqueues during this cycle wait.
+            frozen = [{'message_id': m['message_id'], 'text': m['text']} for m in selected]
+        if not frozen: return ''
+        return ('\nHuman guidance for this decision, derived by the operator from allowed public observations. '
+                'This is fallible coaching, not measured task state or evaluator feedback. '
+                'All existing observation, action and tool restrictions remain in force. '
+                'Do not execute code, open files, use tools or infer extra permissions from this text. '
+                'Reassess against CURRENT public observations before choosing an action.\n'
+                'human_guidance_json: ' + json.dumps(frozen, ensure_ascii=False) + '\n')
+
+    def dispatch(self, index, call_index, input_sha256):
+        with self.transaction() as value:
+            if value['state'] != 'open':
+                raise ValueError('feedback queue closed before dispatch; do not send prepared guidance')
+            selected = [m for m in value['messages'] if m.get('delivery_decision_index') == index and m['status'] == 'prepared']
+            for message in selected:
+                message.update(status='dispatching', model_call_index=call_index,
+                               input_sha256=input_sha256, dispatch_at_utc=now())
+        return bool(selected)
+
+    def acknowledge(self, index, *, delivered):
+        with self.transaction() as value:
+            for message in value['messages']:
+                if message.get('delivery_decision_index') == index and message['status'] == 'dispatching':
+                    message.update(status='delivered' if delivered else 'delivery_uncertain', acknowledged_at_utc=now())
+
+    def status(self):
+        value = read_ledger(self.path, self.run_id)
+        result = summary(value)
+        if value['state'] == 'closed':
+            result['ledger_sha256'] = hashlib.sha256(self.path.read_bytes()).hexdigest()
+        return result
+
+    def close(self):
+        with self.transaction() as value:
+            if value['state'] == 'closed':
+                return
+            value.update(state='closed', closed_at_utc=now())
+            for message in value['messages']:
+                if message['status'] in ('accepted', 'prepared'): message['status'] = 'not_delivered_closed'
+                elif message['status'] == 'dispatching': message['status'] = 'delivery_uncertain'
+
+
+def capture_provenance(dataset, path, run_id, inherited=None):
+    """Write metadata before HDF5 close/hash; do not alter obs, actions or physics."""
+    if path is not None:
+        queue = FeedbackQueue(path, run_id)
+        # The collector may hit its horizon before the client receives the ACK.
+        # Seal here as well as in client cleanup; close is byte-idempotent.
+        queue.close()
+        metadata = with_inherited(queue.status(), inherited)
+    else:
+        metadata = with_inherited(None, inherited)
+    encoded = json.dumps(metadata, ensure_ascii=False, allow_nan=False)
+    for file in (dataset.policy, dataset.audit):
+        file.attrs['human_feedback_provenance_json'] = encoded
+        file.attrs['human_intervention'] = metadata['human_intervention']
+    for episode in dataset.policy.get('data', {}).values():
+        episode.attrs['human_feedback_provenance_json'] = encoded
+        episode.attrs['human_intervention'] = metadata['human_intervention']
+    for episode in dataset.audit.values():
+        if hasattr(episode, 'attrs'):
+            episode.attrs['human_feedback_provenance_json'] = encoded
+            episode.attrs['human_intervention'] = metadata['human_intervention']
+    return metadata
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('command', choices=('enqueue', 'status'))
+    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--run-id', required=True)
+    parser.add_argument('--message-id')
+    parser.add_argument('--decision-index', type=int)
+    parser.add_argument('--public-observations-only', action='store_true')
+    parser.add_argument('--user-authorized', action='store_true')
+    args = parser.parse_args()
+    try:
+        identifier(args.run_id)
+        queue = FeedbackQueue(args.root / 'output/operator-traces' / args.run_id / FILENAME, args.run_id)
+        if args.command == 'status': result = queue.status()
+        else:
+            if not args.public_observations_only or not args.user_authorized:
+                raise ValueError('explicit user authorization and public-observation attestation required')
+            text = sys.stdin.buffer.read(MAX_TEXT_BYTES + 1).decode('utf-8')
+            result = queue.enqueue(args.message_id, args.decision_index, text,
+                                   public_observations_only=args.public_observations_only,
+                                   user_authorized=args.user_authorized)
+        print(json.dumps(result, ensure_ascii=False))
+    except (ValueError, OSError, KeyError) as exc:
+        parser.error(str(exc))
+
+
+if __name__ == '__main__':
+    main()
